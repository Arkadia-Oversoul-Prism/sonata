<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ──────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The floating player is a window that must outlive the app being in the
         background, so it is a foreground service. "special use" is the correct
         declared type for an always-visible control surface that is neither media
         playback (SpeechService owns that) nor location/camera/mic. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Requested at runtime on API 33+; without it the playback notification —
         and therefore every transport control — is invisible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- INTERNET is deliberately NOT declared.

         Sonata is an offline reader. The committed privacy policy
         (ai.sonata.privacy.ManifestAudit) requires that the app cannot reach the
         network, and regression test R11 fails the build if this permission comes
         back. Stage 7a found the permission still present: the online tier had
         never actually been removed. Removing it is what makes the offline
         guarantee checkable rather than asserted.

         Consequence, recorded rather than hidden: OkHttpTtsTransport is no longer
         reachable in the shipped app, because any socket it opens would fail. See
         SONATA_KNOWN_LIMITATIONS.md. -->

    <application
        android:name=".SonataApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_sonata"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_sonata"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sonata">

        <!-- ── Main launcher ────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── PROCESS_TEXT and share targets ─────────────────────────
             Two routes in, both handled by ProcessTextActivity:
             PROCESS_TEXT is the text-selection menu; SEND is the system share
             sheet. Only the first was declared, so "share to Sonata" silently
             never appeared even though the code accepted EXTRA_TEXT.

             SEND is declared for `text/*`, not `text/plain`, because a file
             shared from a file manager arrives with its own media type —
             `text/markdown` for a `.md`, and a vendor type for some `.txt`
             providers. At `text/plain` those files never reached Sonata at all,
             which is why the S3 import step appeared not to exist. The type is a
             routing hint only: what is accepted is decided by DocumentImport. -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:theme="@style/Theme.Sonata.Transparent"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- ── Foreground TTS service ────────────────────────────────── -->
        <service
            android:name=".SpeechService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ── Floating overlay service ──────────────────────────────── -->
        <service
            android:name=".FloatingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating playback controls shown over other apps" />
        </service>

    </application>
</manifest>
