<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating player: the same visual language as the main screen, condensed.

  Deliberately narrow. It floats over another app, so it must be readable at a
  glance and small enough not to block the content underneath. Three things only:
  what is playing, play/pause, and the way back into the app or out of the overlay.

  The root view's touch listener drives drag and tap (see FloatingOverlayService);
  the tap is recognised there rather than through a click listener, because the
  drag listener consumes ACTION_DOWN.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="248dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/overlay_bg"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="12dp"
    app:strokeColor="@color/overlay_border"
    app:strokeWidth="1dp"
    android:contentDescription="@string/app_name">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Header: identity, collapse, close. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_wave"
                app:tint="@color/accent_teal"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/app_name"
                android:textColor="@color/accent_teal"
                android:textSize="10sp"
                android:letterSpacing="0.3"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCollapse"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:src="@drawable/ic_collapse"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_secondary"
                android:scaleType="centerInside"
                android:contentDescription="@string/action_collapse" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_dim"
                android:scaleType="centerInside"
                android:contentDescription="@string/action_close" />
        </LinearLayout>

        <!-- What is playing. -->
        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_meta"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.25" />

        <!-- Controls: one primary, two secondary, all at the 48dp floor. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_sm">

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:src="@drawable/ic_pause"
                android:background="@drawable/bg_play_btn"
                app:tint="@color/bg_dark"
                android:scaleType="centerInside"
                android:contentDescription="@string/action_pause" />

            <ImageButton
                android:id="@+id/btnStop"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_xs"
                android:src="@drawable/ic_stop"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_secondary"
                android:scaleType="centerInside"
                android:contentDescription="@string/action_stop" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed"
                style="@style/Button.Sonata.Chip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="@string/speed_default"
                android:textSize="@dimen/text_meta"
                android:contentDescription="@string/label_speed" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
