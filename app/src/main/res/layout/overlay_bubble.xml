<?xml version="1.0" encoding="utf-8"?>
<!-- The collapsed state: one small draggable circle. Tapping it expands the player. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivBubble"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:padding="14dp"
        android:src="@drawable/ic_sonata"
        android:background="@drawable/bg_play_btn"
        android:contentDescription="Sonata player" />
</FrameLayout>
