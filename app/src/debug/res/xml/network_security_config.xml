<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  Android blocks cleartext HTTP by default from API 28. Instrumented tests run
  against a local MockWebServer over http://localhost, so the debug build needs
  an explicit exemption for that host.

  This file is deliberately confined to the debug source set: the release build
  keeps the platform default, which refuses cleartext outright. A blanket
  usesCleartextTraffic="true" would have weakened the shipped app to make a test
  pass.
-->
<network-security-config>
    <!-- Loopback only. No LAN, no arbitrary host, no user-supplied origin. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Everything else, including a user-configured backend, still requires TLS. -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
